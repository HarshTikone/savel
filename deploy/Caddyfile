{$DOMAIN} {
	encode gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/web
		# The page itself is always re-checked, so a new deploy shows up without a hard refresh;
		# build files have a content hash in their name and can be cached for good.
		@notassets not path /assets/*
		header @notassets Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
